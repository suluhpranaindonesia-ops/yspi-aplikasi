.vercel
.env*

# Repo git hanya memuat kode aplikasi yang di-whitelist; sisanya tetap lokal
/*
!/.gitignore
!/laporan-guru/
!/pendataan-guru-yspi/
!/kewajiban/
!/wa-pengingat/
!/yspi-pelaporan/
# yspi-vercel: website pelaporan guru yang AKTIF (Vercel yspi-cerita-pencapaian).
# yspi-pelaporan di atas = versi Cloudflare, pensiun sejak 9 Okt 2026.
!/yspi-vercel/
!/.github/
# kewajiban: hanya kode. Isi pesan, nominal, nama penerima, alamat rahasia
# kalender, dan ID grup tetap lokal.
kewajiban/hasil/
kewajiban/tambahan.json
kewajiban/kalender.txt
kewajiban/kalender-state.json
kewajiban/lokal.json
*.bak-*
# keuangan-web sengaja TIDAK ikut: kodenya memuat angka & keputusan keuangan

# Data, log, sandi, dan sesi tidak pernah ikut ke GitHub
data/
desktop.ini
node_modules/
*.log
